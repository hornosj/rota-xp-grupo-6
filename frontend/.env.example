# Copie para .env.local e ajuste.

# true = o front usa as fixtures de src/mocks (não precisa do backend). É também o plano B da demo.
# Sem a variável (ou qualquer valor diferente de "true"), o front chama o backend real via /api.
NEXT_PUBLIC_USE_MOCKS=false

# URL do backend Spring Boot para o rewrite /api/* (lido no servidor do Next).
BACKEND_URL=http://localhost:8080
